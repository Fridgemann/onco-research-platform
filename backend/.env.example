# Copy this file to .env and fill in secrets.
# Never commit .env.

# Application
APP_ENV=development

# Security — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Database (note: local dev uses port 5433 to avoid conflict with system PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/oncology_db

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oncology-datasets
MINIO_SECURE=false

# SMTP (optional — dev logs invite links to console if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@oncologyplatform.com

# Frontend origin (used for CORS in production and invite email links)
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# Analysis job limits
KM_ABSOLUTE_MAX_GROUPS=100
KM_MAX_UNIQUE_TIMES=2000
